{
  "version": "0.1.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "custom-field",
    "cascading-select",
    "dependent-dropdown"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "yup": "0.32.9"
  },
  "devDependencies": {
    "@strapi/strapi": "^5.55.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "prettier": "^3.9.9",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@strapi/typescript-utils": "^5.55.1",
    "typescript": "^5.9.3",
    "@strapi/utils": "^5.55.1"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "@strapi/sdk-plugin": "^5.0.0 || ^6.0.0",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "@strapi/utils": "^5.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "cascading-select",
    "displayName": "Cascading Select",
    "description": "Parent to child cascading dropdown custom field (e.g. Atoll > Island, State > City)"
  },
  "name": "strapi-plugin-cascading-select",
  "description": "Parent to child cascading dropdown custom field (e.g. Atoll > Island, State > City)",
  "license": "MIT",
  "author": "mushfau <mushfau@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushfau/strapi-plugin-cascading-select.git",
    "directory": "strapi-plugin-cascading-select"
  },
  "homepage": "https://github.com/mushfau/strapi-plugin-cascading-select/tree/main/strapi-plugin-cascading-select#readme",
  "bugs": {
    "url": "https://github.com/mushfau/strapi-plugin-cascading-select/issues"
  }
}
